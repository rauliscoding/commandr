# Commandr configuration for docker-compose.prod.yml (self-hosting / production).
# Copy to `.env`, fill in every REQUIRED value, never commit the result.
# Every variable the backend reads is listed here — add new ones in the same change.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"                                  # passwords, secret key
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"     # vault keys

# --- Domains (REQUIRED) -------------------------------------------------------
# DNS A/AAAA records for both must point at this server before first start:
# Caddy obtains TLS certificates for them automatically.
APP_DOMAIN=app.example.com
INGEST_DOMAIN=ingest.example.com

# --- Secrets (REQUIRED) --------------------------------------------------------
DJANGO_SECRET_KEY=
# Database roles: superuser (init + maintenance only), owner (migrations), app (runtime).
POSTGRES_SUPERUSER_PASSWORD=
COMMANDR_OWNER_PASSWORD=
COMMANDR_APP_PASSWORD=
# Encrypts every stored OAuth token and API key. Comma-separated, NEWEST FIRST.
# LOSING THESE KEYS MEANS LOSING EVERY CONNECTED ACCOUNT — back them up apart from
# the database (a password manager), or the backups are useless for credentials.
VAULT_KEYS=

# --- Email (optional, recommended) -------------------------------------------
# Commandr's own mail: verification, password reset, alerts. Resend over SMTP:
# host smtp.resend.com, port 465, user "resend", password = a Resend API key.
# Without it, sign-up verification emails cannot be sent.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Commandr <no-reply@example.com>

# --- Monitoring (optional) ---------------------------------------------------------
# Alerts and the daily digest are emailed through the settings above.
# A failing check is re-sent as "still failing" at most this often.
# MONITORING_ALERT_COOLDOWN_MINUTES=60
# Local hour (in each organization's time zone) the daily digest goes out.
# MONITORING_DIGEST_HOUR=7
# Raw metric points are dropped a whole month at a time once older than this.
# METRICS_RAW_RETENTION_DAYS=90

# --- Google sign-in (optional) -------------------------------------------------
# OAuth client from Google Cloud Console; redirect URI:
#   https://<APP_DOMAIN>/accounts/google/login/callback/
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# --- Deployment (optional) -------------------------------------------------------
# Where Postgres and Redis keep their data on the host. Put it on a backed-up volume.
DATA_DIR=./data
# Pin a release instead of :latest for predictable upgrades.
COMMANDR_API_IMAGE=ghcr.io/rauliscoding/commandr-api:latest
COMMANDR_WEB_IMAGE=ghcr.io/rauliscoding/commandr-web:latest

# --- Advanced (rarely changed) --------------------------------------------------
# Public origin of the ingest API, shown in heartbeat URLs and setup snippets.
# Defaults to https://<INGEST_DOMAIN> in docker-compose.prod.yml.
# INGEST_ORIGIN=https://ingest.example.com
# Redis for the ingest stream; defaults to the broker's Redis.
# INGEST_STREAM_URL=redis://redis:6379/0
# INGEST_STREAM_MAXLEN=100000
# Every limit is per ingest key / per heartbeat, never global.
# INGEST_RATE_LIMIT_PER_MINUTE=600
# HEARTBEAT_RATE_LIMIT_PER_MINUTE=60
# Cardinality caps: series per project, distinct values per attribute key.
# INGEST_MAX_SERIES_PER_PROJECT=2000
# INGEST_MAX_ATTR_VALUES=500
# Peers whose X-Forwarded-For is believed (Caddy). docker-compose.prod.yml sets
# the private ranges, because only Caddy can reach web/ingest there.
# TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8
# ACCOUNT_EMAIL_VERIFICATION=mandatory   # mandatory | optional | none
# LOG_LEVEL=INFO
# DB_CONN_MAX_AGE=60
